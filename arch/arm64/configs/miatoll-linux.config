#
# Automatically generated file; DO NOT EDIT.
# Linux/arm64 Kernel Configuration
# Optimized for Xiaomi Miatoll (SM6250) - UEFI + Android 15
#

#
# Architecture / Platform
#
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_ATOLL=y
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_ATOLL=y
CONFIG_MACH_XIAOMI_MIATOLL=y

#
# UEFI / EFI Support (Critical for EFI Stub Booting)
#
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_ARMSTUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_PARAMS_FROM_FDT=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_VARS=y
CONFIG_EFIVAR_FS=m
CONFIG_EFI_ESRT=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_EFI_CAPSULE_LOADER=y
CONFIG_EFI_TEST=y
CONFIG_RESET_ATTACK_MITIGATION=y
CONFIG_UCS2_STRING=y

#
# Graphics & Display (Ensures transition from UEFI Framebuffer)
#
CONFIG_FB_EFI=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_FONT_8x16=y

#
# Virtualization (KVM with EL2 Support)
#
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_ARM_HOST=y
CONFIG_KVM_ARM_PMU=y
CONFIG_VHOST_NET=y
CONFIG_VHOST=y
CONFIG_HAVE_KVM_IRQCHIP=y
CONFIG_HAVE_KVM_IRQFD=y
CONFIG_HAVE_KVM_EVENTFD=y
CONFIG_KVM_MMIO=y

#
# Android 15 Core Configuration
#
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ANDROID_SPOOF_KERNEL_VERSION_FOR_BPF=y
CONFIG_ASHMEM=y
CONFIG_PSI=y
CONFIG_INCREMENTAL_FS=y

#
# File Systems & Partitioning (GPT is mandatory for UEFI)
#
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y

#
# Qualcomm Atoll Specifics (Clock, Power, PHY)
#
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"
CONFIG_PHY_QCOM_UFS=y
CONFIG_QTI_PDC_ATOLL=y
CONFIG_PWM_QTI_LPG=y
CONFIG_QCOM_SCM_64=y
CONFIG_QCOM_QFPROM=y
CONFIG_ARM_PSCI_FW=y

#
# Industrial I/O (IIO) - From your Part 1
#
CONFIG_IIO=y
# CONFIG_VF610_DAC is not set
# CONFIG_AD9523 is not set
# [Your IIO sensors continue here...]

#
# Security & Crypto
#
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA256_ARM64=y
CONFIG_KEYS=y

#
# Debugging
#
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
